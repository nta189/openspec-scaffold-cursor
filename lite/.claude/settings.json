{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["Read(**)", "Edit(src/**)", "Edit(tests/**)", "Edit(docs/**)", "Bash(ls *)", "Bash(cat *)", "Bash(grep *)", "Bash(git status)", "Bash(git log *)", "Bash(git diff *)", "Bash(git add *)", "Bash(git commit *)", "Bash(npm run *)", "Bash(npm test *)", "Bash(bash scripts/*)"],
    "deny": ["Bash(rm -rf *)", "Bash(git push --force *)", "Read(.env)", "Read(.env.*)", "Edit(.env)", "Edit(.claude/settings.json)"]
  },
  "customInstructions": "Read CLAUDE.md first. SAFETY.md is always loaded.",
  "hooks": {
    "Stop": [{"hooks": [{"type": "command", "command": "bash scripts/checkpoint.sh auto idle auto-checkpoint 2>/dev/null || true"}]}]
  }
}
